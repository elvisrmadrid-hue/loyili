# Copiar este archivo como .env.local y completar los valores.
# .env.local NO se sube a Git. Este archivo (.env.example) sí, pero sin secretos.
#
# Valores en: Supabase Dashboard > Project Settings > API Keys / Data API
# (Se configuran en el Módulo 1)

# URL del proyecto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (pública, protegida por RLS). En proyectos antiguos: "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (SOLO servidor, nunca con prefijo NEXT_PUBLIC_). En proyectos antiguos: "service_role key".
SUPABASE_SECRET_KEY=

# URL base de la app (para enlaces de correo, redirecciones de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
